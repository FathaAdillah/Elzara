          "legendFormat": "used"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Webhook delay p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(elzara_webhook_delay_seconds_bucket[15m])))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Oversell / paid-stock / RBAC bypass",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(elzara_oversell_anomalies_total[1h])",
          "legendFormat": "oversell"
        },
        {
          "refId": "B",
          "expr": "increase(elzara_paid_stock_exceptions_total[1h])",
          "legendFormat": "paid-stock"
        },
        {
          "refId": "C",
          "expr": "increase(elzara_rbac_bypass_total[1h])",
          "legendFormat": "rbac bypass"
        }
