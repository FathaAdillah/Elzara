# apps/web — padanan sisi Next.js dari inventaris variabel root `.env.example`
# (Doc 01 §11.3: root adalah satu-satunya sumber kebenaran; berkas ini hanya memetakan
# apa yang dibaca app ini). Hanya NAMA + CONTOH FORMAT; tidak ada satu pun nilai rahasia.
# `NEXT_PUBLIC_*` = aman diketahui browser; rahasia tidak pernah memakai prefiks itu
# (Doc 01 §9.3, ADR-007 D-4).

# --- identifikasi & runtime
APP_ENV=local
APP_NAME=elzara-web
PORT=3000

# --- dua hostname untuk satu API (pelajaran yang sama dengan dua endpoint MinIO)
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_INTERNAL_URL=http://nginx:8080
API_PUBLIC_ORIGIN=http://localhost

# --- asal gambar/aset: host yang BENAR-BENAR bisa dijangkau browser
# (MinIO `product-media` via edge /storage atau CDN terkontrol — Doc 01 §9.2, Doc 04 §8).
MEDIA_PUBLIC_ORIGIN=http://localhost/storage
ASSET_URL=http://localhost/storage/product-media

# --- SEO/OG untuk metadata publik
NEXT_PUBLIC_SITE_URL=http://localhost

# --- tema: token dimiliki packages/ui, app hanya memilih preset saat build (Doc 04 §2.1)
NEXT_PUBLIC_BRAND_THEME=brand

# --- sesi & CSRF: ARAH SAJA, BELUM FINAL (ADR-007 `Proposed`, Q-2 / threat model).
# Jangan mengimplementasi endpoint terautentikasi sebelum ADR-007 tertutup (Doc 12 §3.1);
# sesi storefront dipisah dari sesi admin dengan kebijakan cookie sendiri (ADR-007 D-4).
SESSION_COOKIE_NAME=elzara_session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=elzara_csrf
CSRF_TOKEN_HEADER=X-CSRF-TOKEN
