# Nuxt admin runtime. Keep deployment secrets outside this file.
NUXT_API_INTERNAL_ORIGIN=http://nginx:8080
NUXT_ADMIN_ORIGIN=http://admin.localhost
# Set after Laravel provides a verified admin session endpoint.
NUXT_ADMIN_SESSION_PATH=
# The local Compose override enables a separate synthetic-data preview.
NUXT_PUBLIC_PREVIEW_ENABLED=false
