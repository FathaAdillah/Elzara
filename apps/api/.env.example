# apps/api — satu-satunya daftar variabel yang dibaca kode API (Doc 01 §11.3).
# Aturan CI: tidak ada variabel yang dibaca kode tapi tidak terdaftar di sini.
# Nilai di bawah adalah nama + contoh format; tidak ada rahasia di berkas ini.

# --- aplikasi
APP_NAME="Elzara API"
APP_ENV=local
APP_DEBUG=true
APP_URL=https://localhost
APP_KEY=
# kunci lama yang masih harus bisa membaca payload terenkripsi lama (rotasi, runbook data-breach.md)
APP_PREVIOUS_KEYS=
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=cache

# --- postgres (satu-satunya store; tidak ada sqlite, juga tidak di test — B-11)
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=elzara
DB_USERNAME=elzara
DB_PASSWORD=
DB_CHARSET=utf8
DB_SCHEMA=public
DB_SEARCH_PATH=public
DB_SSLMODE=prefer

# --- redis (sesi + cache + antrian; tabel sessions bawaan tidak dipakai — Doc 01 §11.3)
REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=elzara_
REDIS_CLUSTER=redis
REDIS_PERSISTENT=false
CACHE_STORE=redis
CACHE_PREFIX=
REDIS_CACHE_CONNECTION=default
REDIS_CACHE_LOCK_CONNECTION=default
SESSION_DRIVER=redis
SESSION_CONNECTION=
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_COOKIE=elzara_web_session
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
SESSION_STORE=
SESSION_TABLE=sessions

# --- antrean + horizon (tujuh dan hanya tujuh antrian: payments, orders, inventory, notifications, imports, reports, media)
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_QUEUE=orders
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=90
DB_QUEUE=orders
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE_RETRY_AFTER=90
HORIZON_NAME="Elzara API"
HORIZON_DOMAIN=
HORIZON_PATH=horizon
HORIZON_PREFIX=elzara:horizon:
HORIZON_HISTORY=3600
HORIZON_MEMORY_LIMIT=64

# --- object storage (dua endpoint wajib ada — ADR-008 K-7)
# internal: alamat container yang dipakai SDK untuk operasi server-side
MINIO_ENDPOINT=http://minio:9000
# padanan yang dibaca AWS SDK / docker compose untuk endpoint yang sama
AWS_ENDPOINT_URL=http://minio:9000
# publik: origin S3 khusus tanpa prefix; proxy mempertahankan URI dan Host untuk SigV4
MINIO_PUBLIC_ENDPOINT=https://storage.localhost
MINIO_PUBLIC_TLS_VERIFY=false
MINIO_PRESIGN_EXPIRY_SECONDS=600
FILESYSTEM_DISK=local
AWS_DEFAULT_REGION=id-jkt-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_USE_PATH_STYLE_ENDPOINT=true
# service account aplikasi (bukan root) untuk presign yang dilepas ke klien
ELZARA_S3_ACCESS_KEY=
ELZARA_S3_SECRET_KEY=

# --- log
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

# --- surat (mailer dev ditangkap mailpit; provider nyata hanya di staging/production)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@elzara.test
MAIL_FROM_NAME="Elzara"

# --- Elasticsearch (Docker network search)
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_API_KEY=

# --- Login sosial storefront (Google, X). Kosongkan bila belum dipakai.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
