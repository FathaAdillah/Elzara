{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "elzara/api",
    "type": "project",
    "description": "Elzara /api/v1 — modular monolith PHP 8.4, satu-satunya pemilik database (Doc 01 §3.1).",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "aws/aws-sdk-php": "^3.407",
        "dedoc/scramble": "^0.13",
        "laravel/framework": "^13.42",
        "laravel/horizon": "^5.51",
        "laravel/sanctum": "^4.5",
        "laravel/socialite": "^5.33",
        "league/flysystem-aws-s3-v3": "^3.35",
        "maatwebsite/excel": "^4.0",
        "sentry/sentry-laravel": "^4.30",
        "socialiteproviders/twitter": "^4.1",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-permission": "^8.5",
        "spomky-labs/otphp": "^11.5"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "App\\": "app/",
            "App\\Modules\\": "app/Modules/",
            "App\\Platform\\": "app/Platform/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "deptrac": [
            "@php vendor/bin/deptrac analyse --cache-file=.deptrac.cache"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "dev:db-fresh": [
            "@php artisan migrate:fresh --force",
            "@php artisan db:seed --force --class=ReferenceSeeder"
        ],
        "dev:db-demo": [
            "@dev:db-fresh",
            "@php artisan db:seed --force --class=DemoSeeder"
        ]
    },
    "scripts-descriptions": {
        "test": "Suite PHPUnit (Unit/Feature/Contract/Concurrency) — butuh PostgreSQL 16 nyata, tidak ada SQLite (B-11).",
        "analyse": "PHPStan level max lewat Larastan.",
        "deptrac": "Architecture test batas antar modul B1-B6.",
        "lint": "Pint dalam mode periksa."
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
