# Satu pemilik daftar variabel = .env.example (Doc 01 §11.3); berkas ini daftar yang dibaca edge compose
# untuk ketiga app sekaligus. Nilai rahasia tidak pernah ada di sini: hanya nama + contoh format.
# Copy ke docker/.env, isi, lalu jalankan `bash scripts/dev.sh` untuk profil lokal.
# Setiap nama di bawah diinterpolasi compose.yaml dengan ${VAR:?...} sehingga `up` gagal menyebut nama yang hilang.

# --- edge / compose
APP_ENV=local
APP_DEBUG=true
# Origin publik yang dilihat browser; dipakai APP_URL + presign host.
ELZARA_EDGE_URL=http://localhost
ELZARA_ADMIN_HOST=admin.localhost
ELZARA_ADMIN_ORIGIN=http://admin.localhost
ELZARA_LOCAL_HTTP_PORT=80
ELZARA_LOCAL_MAIL_PORT=8025
GIT_SHA=dev
# Hanya untuk docker/profiles/*.yaml (staging/production): berkas env host target + lokasi sertifikat edge.
ELZARA_ENV_FILE=/etc/elzara/staging.env
TLS_CERT_DIR=./nginx/certs

# --- api
# Format: base64:<32 byte> hasil `php artisan key:generate` di dalam container api.
APP_KEY=
# Prefix Redis terisolasi per environment (ADR-004) — kunci idempotensi tidak boleh berbagi ruang antar env.
HORIZON_PREFIX=elzara-local
# Batas RAM Horizon; diukur nyata saat onboarding node (Doc 01 §11.1).
WORKER_MEMORY_LIMIT=512M
AWS_DEFAULT_REGION=elzara-1
# Origin S3 publik tanpa prefix path; Host dan URI dipertahankan untuk SigV4.
MINIO_PUBLIC_ENDPOINT=http://storage.localhost
# Service account aplikasi (bukan root); dibuat oleh docker/minio/init-buckets.sh.
ELZARA_S3_ACCESS_KEY=
# MinIO menerima 8 sampai 40 karakter untuk secret key service account.
ELZARA_S3_SECRET_KEY=
# Penangkap email lokal di dev, provider nyata di produksi.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SCHEME=smtp
SMTP_USERNAME=
SMTP_PASSWORD=
# Login sosial storefront (opsional; kosong = tombol Google/X gagal di callback). Redirect default {APP_URL}/api/v1/auth/social/{google|x}/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
SMTP_FROM_ADDRESS=hello@localhost

# --- postgres / redis (backend only; tidak ada port ke host, akses lewat SSH tunnel)
POSTGRES_DB=elzara
POSTGRES_USER=elzara
POSTGRES_PASSWORD=

# --- Elasticsearch Basic (profil search, isi password bootstrap sebelum start)
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_MEMORY_LIMIT=1g

# --- minio
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- web
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Preset tema yang dibakar saat build (playful|clean-premium|bold-kpop|brand, Doc 04 §3).
NEXT_PUBLIC_BRAND_THEME=brand
NUXT_PUBLIC_BRAND_THEME=admin

# --- admin
# Path endpoint verifikasi sesi Laravel.
ADMIN_SESSION_PATH=/api/v1/admin/auth/session
# Opsional untuk development lokal. Isi email operator yang boleh login dengan kata sandi saja.
ELZARA_LOCAL_ADMIN_PASSWORD_ONLY_EMAIL=
