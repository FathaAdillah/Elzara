# Satu pemilik daftar variabel = .env.example (Doc 01 §11.3); berkas ini daftar yang dibaca edge compose
# untuk ketiga app sekaligus. Nilai rahasia tidak pernah ada di sini: hanya nama + contoh format.
# Copy ke docker/.env, isi, lalu jalankan `bash scripts/dev.sh` untuk profil lokal.
# Setiap nama di bawah diinterpolasi compose.yaml dengan ${VAR:?...} sehingga `up` gagal menyebut nama yang hilang.

# --- edge / compose
APP_ENV=local
# Set false only for non-production development; production always enforces 2FA.
ADMIN_2FA_ENABLED=true
APP_DEBUG=true
# Origin publik yang dilihat browser; dipakai APP_URL + presign host.
ELZARA_EDGE_URL=http://localhost
ELZARA_ADMIN_HOST=admin.localhost
ELZARA_ADMIN_ORIGIN=http://admin.localhost
ELZARA_LOCAL_HTTP_PORT=80
ELZARA_LOCAL_MAIL_PORT=8025
GIT_SHA=dev
# Hanya untuk docker/profiles/*.yaml (staging/production): berkas env host target + lokasi sertifikat edge.
ELZARA_ENV_FILE=/etc/elzara/staging.env
TLS_CERT_DIR=./nginx/certs

# --- api
# Format: base64:<32 byte> hasil `php artisan key:generate` di dalam container api.
APP_KEY=
# Prefix Redis terisolasi per environment (ADR-004) — kunci idempotensi tidak boleh berbagi ruang antar env.
HORIZON_PREFIX=elzara-local
# Baseline Horizon lokal ~665 MiB per worker; 512 MiB memicu OOM (Doc 01 §11.1).
# Ukur ulang batas RAM sesuai beban dan autoscaling saat onboarding node.
WORKER_MEMORY_LIMIT=1G
AWS_DEFAULT_REGION=elzara-1
# Origin S3 publik tanpa prefix path; Host dan URI dipertahankan untuk SigV4.
MINIO_PUBLIC_ENDPOINT=http://storage.localhost
# Service account aplikasi (bukan root); dibuat oleh docker/minio/init-buckets.sh.
ELZARA_S3_ACCESS_KEY=
# MinIO menerima 8 sampai 40 karakter untuk secret key service account.
ELZARA_S3_SECRET_KEY=
# Kunci server-ke-server storefront -> API (openssl rand -hex 32, minimal 32 karakter): panggilan SSR
# membawanya bersama IP pembeli supaya rate limit `public` per pembeli, bukan per IP container web.
ELZARA_STOREFRONT_PROXY_KEY=
# Penangkap email lokal di dev, provider nyata di produksi.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SCHEME=smtp
SMTP_USERNAME=
SMTP_PASSWORD=
# Login sosial storefront (opsional; kosong = tombol Google/X gagal di callback). Redirect default {APP_URL}/api/v1/auth/social/{google|x}/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Shipping rates (Fulfillment): manual | biteship
CHECKOUT_FAKE_PAYMENT_ENABLED=false
CHECKOUT_WAREHOUSE_CODE=DEMO
CHECKOUT_RESERVATION_TTL_MINUTES=120
SHIPPING_DRIVER=manual
SHIPPING_CACHE_TTL_SECONDS=1800
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_ORIGIN_POSTCODE=
BITESHIP_COURIERS=jne,jnt
BITESHIP_TIMEOUT_SECONDS=10
# Kredensial Biteship: isi dari secret store bila driver biteship dipakai.
BITESHIP_API_KEY=
X_REDIRECT_URI=
SMTP_FROM_ADDRESS=hello@localhost

# --- postgres / redis (backend only; tidak ada port ke host, akses lewat SSH tunnel)
POSTGRES_DB=elzara
POSTGRES_USER=elzara
POSTGRES_PASSWORD=

# --- Elasticsearch Basic (profil search, isi password bootstrap sebelum start)
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_MEMORY_LIMIT=1g

# --- minio
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- web
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Preset tema yang dibakar saat build (playful|clean-premium|bold-kpop|brand, Doc 04 §3).
NEXT_PUBLIC_BRAND_THEME=brand
NUXT_PUBLIC_BRAND_THEME=admin

# --- admin
# Path endpoint verifikasi sesi Laravel.
ADMIN_SESSION_PATH=/api/v1/admin/auth/session
# Opsional untuk development lokal. Isi email operator yang boleh login dengan kata sandi saja.
ELZARA_LOCAL_ADMIN_PASSWORD_ONLY_EMAIL=

# --- observability (Doc 01 §12)
# Log JSON satu baris per event ke stderr; `stack` hanya untuk debugging file lokal.
LOG_CHANNEL=stderr
LOG_LEVEL=info
# Profil compose `monitoring` (Prometheus + Grafana, tidak di-publish; akses via SSH tunnel).
# Kosong = Grafana memakai admin/admin dan memaksa ganti saat login pertama.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=15d

# --- backup off-node (runbook backup-restore-drill; Doc 11 §8.6)
# Lokal: off (profil local juga memaksanya). required = archive_command gagal tertutup bila tujuan kosong; `off` hanya untuk profil local.
ELZARA_BACKUP_MODE=off
# Bucket/prefix di PROVIDER LAIN dari node aplikasi, kredensial khusus backup (bukan MINIO_ROOT_*).
WALG_S3_PREFIX=
# 32 byte hex (openssl rand -hex 32). Simpan juga di luar node: tanpa kunci ini backup tidak bisa dibaca.
WALG_LIBSODIUM_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_FORCE_PATH_STYLE=true
# Base backup harian (jam UTC) oleh service `backup` (profil compose `backup`) + jumlah full backup disimpan.
BACKUP_HOUR_UTC=19
WALG_RETAIN_FULL=7
BACKUP_ON_START=false
# Batas atas RPO: segmen WAL dipaksa diarsip setiap N detik.
WAL_ARCHIVE_TIMEOUT=300
# Salinan objek MinIO (service `object-backup`, profil `backup`) ke provider BACKUP_S3_* di atas, terenkripsi rclone crypt.
# Bucket/prefix tujuan, mis. elzara-backup/objects (bukan bucket MinIO node ini).
OBJECT_BACKUP_S3_PATH=
# Passphrase + salt crypt (openssl rand -hex 32 masing-masing); simpan juga di luar node seperti WALG_LIBSODIUM_KEY.
OBJECT_BACKUP_CRYPT_PASSWORD=

OBJECT_BACKUP_CRYPT_SALT=

OBJECT_BACKUP_INTERVAL_SECONDS=3600
# Versi objek yang terhapus/tertimpa disimpan di deleted/<stamp>/ selama N hari.
OBJECT_BACKUP_RETAIN_DAYS=30
# Service account MinIO baca-saja untuk object-backup (dibuat init-buckets.sh; policy elzara-backup-reader).
ELZARA_BACKUP_READER_ACCESS_KEY=elzara-backup-reader

ELZARA_BACKUP_READER_SECRET_KEY=
