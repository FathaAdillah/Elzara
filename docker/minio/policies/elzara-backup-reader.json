{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::product-media",
        "arn:aws:s3:::request-attachments",
        "arn:aws:s3:::invoice-documents",
        "arn:aws:s3:::shipment-documents",
        "arn:aws:s3:::audit-archives"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::product-media/*",
        "arn:aws:s3:::request-attachments/*",
        "arn:aws:s3:::invoice-documents/*",
        "arn:aws:s3:::shipment-documents/*",
        "arn:aws:s3:::audit-archives/*"
      ]
    },
    {
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:ListAllMyBuckets",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::*"
      ]
    }
  ]
}
