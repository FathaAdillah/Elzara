limit_req_zone $binary_remote_addr zone=api:10m rate=25r/s;
limit_req_zone $web_limit_key zone=web:10m rate=60r/s;
limit_req_zone $admin_limit_key zone=admin:10m rate=15r/s;
limit_req_zone $server_name zone=webhooks:10m rate=50r/s;
limit_req_status 429;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream api_fpm   { server api:9000; }
upstream web_app   { server web:3000; }
upstream admin_app { server admin:3000; }
upstream minio_s3  { server minio:9000; }

map $host $frontend_upstream {
    default web_app;
    ${ELZARA_ADMIN_HOST} admin_app;
}

map $host $storefront_origin {
    default "${ELZARA_EDGE_URL}";
}

map $frontend_upstream $web_limit_key {
    web_app $binary_remote_addr;
    default "";
}

map $frontend_upstream $admin_limit_key {
    admin_app $binary_remote_addr;
    default "";
}

map $edge_scheme $edge_hsts {
    default "";
    https "max-age=63072000; includeSubDomains; preload";
}

map "${MINIO_PUBLIC_ENDPOINT}" $media_origin {
    default "'self'";
    ~^(https?://[^/]+) $1;
}

map $frontend_upstream $frontend_csp {
    web_app "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: $media_origin; font-src 'self'; connect-src 'self' $media_origin; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'";
    admin_app "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: $media_origin; font-src 'self'; connect-src 'self' $media_origin; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'";
}

map $upstream_http_content_security_policy $frontend_fallback_csp {
    default "";
    "" $frontend_csp;
}

map $uri $edge_csp {
    default $frontend_fallback_csp;
    ~^/(api/|sanctum/csrf-cookie$|storage/|nginx-healthz$) "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'none'";
}
